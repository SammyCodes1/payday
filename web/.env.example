# Payday web - environment variable NAMES. Copy to .env.local and fill values locally.
# Never commit .env.local. Values marked [secret] are server-only and must never be NEXT_PUBLIC_.

# --- chain / policy ---
PAYDAY_CHAIN=                 # arcTestnet | anvil
PAYDAY_RPC_URL=               # e.g. https://rpc.testnet.arc.io (testnet) or http://127.0.0.1:8545 (anvil)
PAYDAY_POLICY_ADDRESS=        # deployed SpendPolicy address
PAYDAY_POLICY_DEPLOY_BLOCK=   # block the policy was deployed in (event scan start)
PAYDAY_STATS_POLICIES=        # optional "address:block,address:block" for the public stats page
PAYDAY_LOG_CHUNK=             # optional, eth_getLogs block range per request (default 10000)

# --- agent executor ---
PAYDAY_EXECUTOR=              # circle | local | none   (local = anvil only, dev mnemonic)
PAYDAY_LOCAL_AGENT_INDEX=     # optional, anvil account index for the local agent (default 2)
CIRCLE_API_KEY=               # [secret] Circle Developer Console API key (TEST_API_KEY:... for testnet)
CIRCLE_ENTITY_SECRET=         # [secret] 32-byte entity secret (hex) registered in the Circle console
CIRCLE_AGENT_WALLET_ID=       # Circle wallet id (uuid) of the agent SCA wallet on ARC-TESTNET
CIRCLE_AGENT_WALLET_ADDRESS=  # that wallet's address; must equal SpendPolicy.agent()

# --- LLM ---
PAYDAY_LLM_PROVIDER=          # mock | openai | anthropic | google
PAYDAY_LLM_MODEL=             # model id with vision/PDF support, required unless provider=mock
OPENAI_API_KEY=               # [secret] only if provider=openai
ANTHROPIC_API_KEY=            # [secret] only if provider=anthropic
GOOGLE_GENERATIVE_AI_API_KEY= # [secret] only if provider=google

# --- app ---
SESSION_SECRET=               # [secret] >= 32 random chars, signs owner session cookies
CRON_SECRET=                  # [secret] bearer token for POST /api/cron/due
PAYDAY_APP_ORIGIN=            # e.g. http://localhost:3000 (exact origin; used for SIWE + CSRF checks)
PAYDAY_DB_PATH=               # optional, SQLite file (default ./data/payday.sqlite)
PAYDAY_MAX_UPLOAD_BYTES=      # optional (default 5242880)
PAYDAY_SCHEDULE_LEAD_DAYS=    # optional, pay N days before due date (default 1)
PAYDAY_RUNWAY_BUFFER_USDC=    # optional, keep this much USDC after scheduled bills (default 0)

# --- browser (public, NOT secret) ---
NEXT_PUBLIC_CHAIN=            # arcTestnet | anvil
NEXT_PUBLIC_RPC_URL=          # public RPC for the owner's wallet reads
NEXT_PUBLIC_EXPLORER_URL=     # default https://explorer.testnet.arc.io (official per docs.arc.io/arc/references/connect-to-arc)
